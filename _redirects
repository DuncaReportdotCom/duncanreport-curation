<script>
// Set date
const now = new Date();
document.getElementById('date-line').textContent = now.toLocaleDateString('en-US', { weekday: 'long',
year: 'numeric', month: 'long', day: 'numeric' }) + ' ' + now.toLocaleTimeString('en-US', { hour: 'numeric',
minute: '2-digit', hour12: true });

// ===== ADDED: which section is this page? =====
function currentSection() {
var seg = (location.pathname.split('/').filter(Boolean)[0] || 'main').toLowerCase();
var known = ['sports','world','markets','politics','life-culture'];
return known.indexOf(seg) >= 0 ? seg : 'main';
}
function sectionDataUrl() {
var sec = currentSection();
var path = (sec === 'main') ? '/stories.json' : '/' + sec + '/stories.json';
return path + '?nocache=' + Date.now();
}
// Highlight the nav link for the current section
function highlightNav() {
var sec = currentSection();
var links = document.querySelectorAll('#top-nav a');
for (var i = 0; i < links.length; i++) {
var href = links[i].getAttribute('href');
var linkSec = (href === '/') ? 'main' : href.replace(/^\/+/, '');
if (linkSec === sec) { links[i].classList.add('active'); }
else { links[i].classList.remove('active'); }
}
}
// On a subpage, replace the "DuncanReport.com" masthead with the section name
// in the matching nav color (same font + size). Main keeps the gradient title.
function applyMasthead() {
var sec = currentSection();
var el = document.getElementById('site-title');
if (!el) return;
var map = {
'sports': ['SPORTS', '#cc0000'],
'world': ['WORLD', '#00008B'],
'markets': ['MARKETS', '#006600'],
'politics': ['POLITICS', '#8b0000'],
'life-culture': ['LIFE & CULTURE', '#5500aa']
};
if (map[sec]) {
el.textContent = map[sec][0];
el.style.background = 'none';
el.style.webkitTextFillColor = map[sec][1];
el.style.color = map[sec][1];
el.style.filter = 'none';
document.title = 'DuncanReport.com — ' + map[sec][0];
}
}

let allStories = null;
function showSkeletons() {
document.getElementById('hero-headline').innerHTML = '<span class="skeleton skeleton-hero"></span>';
document.getElementById('sub-headlines').innerHTML = '<span class="skeleton skeleton-sub"></span><span class="skeleton skeleton-sub" style="width:35%;margin:5px auto;display:block"></span>';
['col-left','col-center','col-right'].forEach(id => {
let html = '';
for(let i=0;i<3;i++){
html += `<div class="col-section">
<span class="skeleton skeleton-title"></span>
<span class="skeleton skeleton-link"></span>
<span class="skeleton skeleton-link" style="width:75%"></span>
</div>`;
}
document.getElementById(id).innerHTML = html;
});
}
function toTitleCase(str) {
return str.split(' ').map(word => {
// Strip punctuation to check if core letters are all-caps (e.g. "IEA:" "U.S." "FBI,")
const core = word.replace(/[^a-zA-Z]/g, '');
if (core.length > 1 && core === core.toUpperCase()) return word;
return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
}).join(' ');
}
function tagPrefix(s) {
// Render a small visual tag for entries marked as e.g. "satire".
// Currently supports: tag: "satire". Other values are ignored.
if (s && s.tag === 'satire') return '<span class="satire-tag">Satire</span>';
return '';
}
function storyMainUrl(s) {
// Get primary URL from links array or fall back to legacy url field
return (s.links && s.links[0]) ? s.links[0].url : s.url;
}
function storySubLinks(s) {
if (!s.links || s.links.length < 2) return '';
return s.links.slice(1).map(l =>
`<a class="sub-link" href="${l.url}" target="_blank">${l.label}</a>`
).join('');
}

// ===== ADDED: markets strip (business page) =====
function renderMarkets(quotes) {
var el = document.getElementById('markets');
if (!el) return;
if (!quotes || !quotes.length) { el.innerHTML = ''; return; }
el.innerHTML = quotes.map(function(q) {
var chgText = (q.change || '');
if (q.changePct) { chgText += (chgText ? '  ' : '') + q.changePct; }
var isDown = /-/.test((q.change || '') + (q.changePct || ''));
var chgHtml = chgText.trim()
? ' <span class="mk-chg ' + (isDown ? 'mk-down' : 'mk-up') + '">' + chgText + '</span>'
: '';
return '<span class="mk-item"><span class="mk-name">' + q.name + '</span> ' +
'<span class="mk-val">' + q.value + '</span>' + chgHtml + '</span>';
}).join('<span class="mk-sep">|</span>');
}

// ===== ADDED: scoreboard (sports page) =====
function renderScoreboard(games) {
var el = document.getElementById('scoreboard');
if (!el) return;
if (!games || !games.length) { el.innerHTML = ''; return; }
el.innerHTML = games.map(function(g) {
var right;
if (g.state === 'scheduled' || g.awayScore == null) {
right = '<span class="sb-note">' + (g.note || '') + '</span>';
} else {
right = '<span class="sb-score">' + g.awayScore + '&ndash;' + g.homeScore + '</span> ' +
'<span class="sb-note">' + (g.note || '') + '</span>';
}
var inner = '<span class="sb-league">' + g.league + '</span> ' +
'<span class="sb-teams">' + g.away + ' @ ' + g.home + '</span> &nbsp;' + right;
return g.url
? '<a class="sb-game" href="' + g.url + '" target="_blank">' + inner + '</a>'
: '<span class="sb-game">' + inner + '</span>';
}).join('');
}

function renderStories(data) {
// ADDED: scoreboard + markets render first, regardless of hero
renderMarkets(data && data.markets);
renderScoreboard(data && data.scoreboard);
if (!data || !data.hero) {
document.getElementById('hero-headline').innerHTML = 'NO STORIES FOUND';
document.getElementById('sub-headlines').innerHTML = '';
['col-left','col-center','col-right'].forEach(function(id) { document.getElementById(id).innerHTML = ''; });
return;
}
var hero = data.hero || {};
var groups = data.groups || [];
var leftCols = (data.columns && data.columns.left) || [];
var centerCols = (data.columns && data.columns.center) || [];
var rightCols = (data.columns && data.columns.right) || [];
// Hero
var heroEl = document.getElementById('hero-headline');
if (hero.headline && hero.url) {
heroEl.innerHTML = '<a href="' + hero.url + '" target="_blank">' + hero.headline + '</a>';
}
// Sub-headlines
var subEl = document.getElementById('sub-headlines');
if (hero.sublinks && hero.sublinks.length) {
subEl.innerHTML = hero.sublinks.map(function(s) {
return '<a href="' + s.url + '" target="_blank">' + s.text + '</a>';
}).join(' &nbsp;&bull;&nbsp; ');
} else {
subEl.innerHTML = '';
}
// Build a render helper for a single group panel
function renderGroupPanel(g) {
var html = '<div class="group-panel"><div class="group-title">' + g.title + '</div>';
(g.stories || []).forEach(function(s) {
html += '<div class="col-section grouped"><a href="' + s.url + '" target="_blank">' + tagPrefix(s) + toTitleCase(s.headline) +
'</a></div>';
});
html += '</div>';
return html;
}
// Distribute group panels round-robin: panel #1 -> left, #2 -> center, #3 -> right, #4 -> left, etc.
var panelHTML = ['', '', ''];
groups.forEach(function(g, i) {
panelHTML[i % 3] += renderGroupPanel(g);
});
// Left column: panels first, then standalone left stories
var leftEl = document.getElementById('col-left');
var leftHTML = panelHTML[0];
leftCols.forEach(function(s) {
leftHTML += '<div class="col-section"><a href="' + s.url + '" target="_blank">' + tagPrefix(s) + toTitleCase(s.headline) +
'</a></div>';
});
leftEl.innerHTML = leftHTML;
// Center column: panels first, then standalone center stories
var centerEl = document.getElementById('col-center');
var centerHTML = panelHTML[1];
centerCols.forEach(function(s) {
centerHTML += '<div class="col-section"><a href="' + s.url + '" target="_blank">' + tagPrefix(s) + toTitleCase(s.headline) +
'</a></div>';
});
centerEl.innerHTML = centerHTML;
// Right column: panels first, then standalone right stories
var rightEl = document.getElementById('col-right');
var rightHTML = panelHTML[2];
rightCols.forEach(function(s) {
rightHTML += '<div class="col-section"><a href="' + s.url + '" target="_blank">' + tagPrefix(s) + toTitleCase(s.headline) +
'</a></div>';
});
rightEl.innerHTML = rightHTML;
}
function saveStories(data) {
try { localStorage.setItem('dr_cache_' + currentSection(), JSON.stringify({ts: Date.now(), data: data})); } catch(e) {}
}
async function loadStories() {
try {
var res = await fetch(sectionDataUrl());   // CHANGED: section-aware path
var data = await res.json();
return data;
} catch(e) {
return null;
}
}
function primaryUrl(s) {
return (s.links && s.links[0]) ? s.links[0].url : s.url;
}
function mergeStories(existing, fresh) {
// existing and fresh are both {hero, groups, columns, lastUpdated} objects
// Each story needs a timestamp. Fresh stories get now; existing keep theirs.
const now = Date.now();
const threeDays = 3 * 24 * 60 * 60 * 1000;
function stampStories(stories, ts) {
return (stories || []).map(function(s) {
return Object.assign({}, s, { timestamp: s.timestamp || ts });
});
}
function expireStories(stories) {
return (stories || []).filter(function(s) {
return (now - (s.timestamp || now)) < threeDays;
});
}
function mergeList(existingList, freshList) {
// Stamp fresh stories with now
const stamped = stampStories(freshList, now);
// Keep existing stories that haven't expired
const live = expireStories(existingList);
// Deduplicate by URL - fresh stories win (replace existing with same URL)
const freshUrls = new Set(stamped.map(function(s) { return s.url; }));
const kept = live.filter(function(s) { return !freshUrls.has(s.url); });
// Fresh stories go first (top of column), then surviving old ones
return stamped.concat(kept);
}
function mergeGroups(existingGroups, freshGroups) {
const freshTitles = new Set((freshGroups || []).map(function(g) { return g.title; }));
// Keep old groups not replaced by fresh, expire their stories
const oldKept = (existingGroups || [])
.filter(function(g) { return !freshTitles.has(g.title); })
.map(function(g) {
return Object.assign({}, g, { stories: expireStories(stampStories(g.stories, 0)) });
})
.filter(function(g) { return g.stories.length > 0; });
// Fresh groups get their stories stamped now
const freshStamped = (freshGroups || []).map(function(g) {
return Object.assign({}, g, { stories: stampStories(g.stories, now) });
});
return freshStamped.concat(oldKept);
}
const ex = existing || {};
const fr = fresh || {};
return {
lastUpdated: new Date().toISOString(),
hero: fr.hero || ex.hero || {},
groups: mergeGroups(ex.groups, fr.groups),
columns: {
left: mergeList((ex.columns || {}).left, (fr.columns || {}).left),
center: mergeList((ex.columns || {}).center, (fr.columns || {}).center),
right: mergeList((ex.columns || {}).right, (fr.columns || {}).right)
}
};
}
async function fetchNews() {
highlightNav();   // ADDED: light up the current section's nav link
applyMasthead();  // ADDED: swap masthead to the section name + color on subpages
showSkeletons();
(async () => {
try {
// Load this section's stories.json
const existing = await loadStories();
// Render immediately with existing data
if (existing && (existing.hero || existing.scoreboard || existing.markets)) {
renderStories(existing);
}
// stories.json IS the source of truth - no AI call here.
// The curation engine writes fresh stories externally.
if (!existing || (!existing.hero && !existing.scoreboard && !existing.markets)) {
renderStories({});
}
} catch(err) {
console.error('fetchNews error', err);
renderStories({});
}
})();
}
// Auto-run on load
fetchNews();
</script>
