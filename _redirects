<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DuncanReport.com</title>
<link rel="canonical" href="https://duncanreport.com/" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="description" content="DuncanReport.com - AI-powered news aggregator covering Politics,
Military, Business, Technology and more." />
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
font-family: 'Times New Roman', Times, serif;
background: #fff;
color: #000;
font-size: 14px;
}
/* HEADER */
#header {
text-align: center;
padding: 10px 10px 2px;
}
#site-title {
font-size: 44px;
font-weight: normal;
letter-spacing: -1px;
font-family: "Times New Roman", Times, serif;
background: linear-gradient(180deg, #1a1a1a 0%, #555 60%, #1a1a1a 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
filter: drop-shadow(3px 3px 3px rgba(0,0,0,0.35));
display: inline-block;
}
#date-line {
font-size: 12px;
color: #555;
margin: 10px 0 4px;
}
/* NAV WRAPPER */
#nav-wrapper {
max-width: 1100px;
margin: 0 auto;
}
/* NAV */
#top-nav {
display: flex;
justify-content: center;
gap: 0;
padding: 5px 0;
border-top: 1px solid #ccc;
border-bottom: 1px solid #ccc;
flex-wrap: wrap;
}
#top-nav a {
color: #000000;
text-decoration: underline;
font-size: 12px;
font-weight: bold;
padding: 2px 12px;
border-right: 1px solid #ccc;
cursor: pointer;
text-transform: uppercase;
letter-spacing: 0.5px;
}
#top-nav a:last-child { border-right: none; }
#top-nav a:hover { text-decoration: underline; color: #cc0000; }
#top-nav a.active { color: #cc0000; }
#top-nav a.nav-sports { color: #cc0000; }
#top-nav a.nav-world { color: #00008B; }
#top-nav a.nav-markets { color: #006600; }
#top-nav a.nav-politics { color: #8b0000; }
#top-nav a.nav-life { color: #5500aa; }
#top-nav a.nav-sports:hover { color: #990000; }
#top-nav a.nav-world:hover { color: #00008B; }
#top-nav a.nav-markets:hover { color: #004400; }
#top-nav a.nav-politics:hover { color: #5a0000; }
#top-nav a.nav-life:hover { color: #330077; }
/* SOURCE BAR */
#source-bar {
display: flex;
justify-content: center;
flex-wrap: wrap;
gap: 0;
padding: 4px 10px;
border-bottom: 1px solid #ccc;
background: #fff;
}
#source-bar a {
color: #00008B;
text-decoration: underline;
font-size: 10px;
padding: 1px 6px;
border-right: 1px solid #ccc;
}
#source-bar a:last-child { border-right: none; }
#source-bar a:hover { text-decoration: underline; }
/* MAIN CONTENT */
#main-content {
max-width: 1100px;
margin: 0 auto;
padding: 6px;
}
/* HERO */
#hero {
text-align: center;
padding: 8px 20px;
margin-bottom: 6px;
}
#hero-headline {
font-size: 28px;
font-weight: bold;
text-transform: uppercase;
line-height: 1.2;
margin-bottom: 4px;
}
#hero-headline a {
color: #00008B;
text-decoration: underline;
}
#hero-headline a:hover { color: #cc0000; text-decoration: underline; }
.sub-headline {
font-size: 15px;
font-weight: bold;
text-transform: uppercase;
margin: 1px 0;
}
.sub-headline a {
color: #00008B;
text-decoration: none;
}
.sub-headline a:hover { text-decoration: underline; }
/* COLUMNS */
#columns {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 0;
}
.col {
padding: 4px 8px;
border-right: 1px solid #ccc;
}
.col:last-child { border-right: none; }
.col-section {
margin-bottom: 4px;
border-top: 1px solid #ccc;
padding-top: 3px;
}
.col-section:first-child,
.col-section.grouped {
border-top: none;
padding-top: 0;
}
.group-panel + .group-panel {
border-top: 1px solid #ccc;
padding-top: 3px;
}
.col-section-title {
font-size: 15px;
font-weight: bold;
margin-bottom: 2px;
line-height: 1.2;
}
.col-section-title a {
color: #00008B;
text-decoration: underline;
}
.col-section-title a:hover { color: #cc0000; text-decoration: underline; }
.col-link {
display: block;
color: #00008B;
text-decoration: none;
font-size: 12px;
margin: 0;
line-height: 1.15;
}
.col-link:hover { text-decoration: underline; }
.satire-tag {
display: inline-block;
font-size: 9px;
font-weight: bold;
color: #888;
border: 1px solid #888;
padding: 0 3px;
margin-right: 4px;
text-transform: uppercase;
letter-spacing: 0.5px;
vertical-align: middle;
font-family: Arial, sans-serif;
}
/* LOADING SKELETON */
.skeleton {
background: linear-gradient(90deg, #eee 25%, #ddd 50%, #eee 75%);
background-size: 200% 100%;
animation: shimmer 1.2s infinite;
border-radius: 2px;
display: block;
}
@keyframes shimmer {
0% { background-position: 200% 0; }
100% { background-position: -200% 0; }
}
.skeleton-hero { height: 36px; width: 70%; margin: 0 auto 8px; }
.skeleton-sub { height: 20px; width: 45%; margin: 5px auto; }
.skeleton-title { height: 18px; width: 80%; margin-bottom: 6px; }
.skeleton-link { height: 14px; width: 90%; margin: 3px 0; }
/* FOOTER */
#footer {
text-align: center;
padding: 16px;
border-top: 2px solid #ccc;
margin-top: 20px;
font-size: 11px;
color: #555;
}
@media (max-width: 700px) {
#columns { grid-template-columns: 1fr; }
.col { border-right: none; border-bottom: 1px solid #ccc; }
#site-title { font-size: 26px; }
#hero-headline { font-size: 18px; }
#top-nav a { font-size: 11px; padding: 2px 6px; }
#source-bar a { font-size: 10px; padding: 1px 4px; }
#main-content { padding: 6px; }
.sub-headline { font-size: 13px; }
}
/* MAJOR STORY GROUP PANELS */
.group-panel {
margin-bottom: 16px;
}
.group-panel-title a {
font-family: 'Arial Black', Arial, sans-serif;
font-size: 15px;
font-weight: 900;
color: #00008B;
text-decoration: underline;
display: block;
margin-bottom: 0;
line-height: 1.3;
}
.group-panel-item {
font-size: 13px;
line-height: 1.5;
padding: 2px 0;
}
.group-panel-item a {
text-decoration: underline;
color: #00008B;
}
/* SUB-LINKS */
.sub-link {
display: block;
font-size: 11px;
color: #00008B;
text-decoration: underline;
margin: 1px 0;
line-height: 1.4;
}
.sub-link:hover { text-decoration: underline; }
#sub-headlines {
text-align: center;
margin: 6px auto 16px;
max-width: 700px;
}
.hero-sub-item {
font-size: 14px;
line-height: 1.8;
}
.hero-sub-item a {
color: #00008B;
text-decoration: underline;
}
/* ===== ADDED: MARKETS STRIP (business page) ===== */
#markets {
max-width: 1100px;
margin: 0 auto 6px;
padding: 5px 8px;
text-align: center;
border-bottom: 1px solid #ccc;
font-size: 12px;
line-height: 1.8;
}
#markets:empty { display: none; }
.mk-item { white-space: nowrap; }
.mk-name { font-weight: bold; }
.mk-chg.mk-up { color: #006600; }
.mk-chg.mk-down { color: #cc0000; }
.mk-sep { color: #ccc; padding: 0 7px; }
/* ===== ADDED: SCOREBOARD (sports page) ===== */
#scoreboard {
max-width: 1100px;
margin: 0 auto 8px;
padding: 4px 8px;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 0 18px;
}
#scoreboard:empty { display: none; }
.sb-game {
display: block;
font-size: 12px;
line-height: 1.5;
color: #00008B;
text-decoration: none;
padding: 2px 0;
border-bottom: 1px solid #eee;
}
.sb-game:hover { text-decoration: underline; }
.sb-league { font-weight: bold; color: #555; font-size: 10px; }
.sb-score { font-weight: bold; color: #000; }
.sb-note { color: #555; }
@media (max-width: 700px) {
#scoreboard { grid-template-columns: 1fr; }
}
</style>
</head>
